# Copy to .env and edit. Nothing here refers to the project directory name, so
# the checkout can be renamed freely.
#
# DJANGO_SECRET_KEY, a non-SQLite DATABASE_URL and REDIS_URL are REQUIRED
# whenever DJANGO_DEBUG is false; the service refuses to start without them
# rather than silently serving 404s from an empty SQLite file with a well-known
# key.

# Set to true for local development. Leave false everywhere else. A command that
# needs no database (collectstatic in the Dockerfile) can bypass the check with
# ARKSERVICE_SKIP_CONFIG_CHECK=1 in its environment; never set it for a server.
DJANGO_DEBUG=false

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Production uses an existing MySQL/MariaDB server, on the same machine or
# across the network. Percent-encode special characters in the password.
# DATABASE_URL=mysql://arkuser:password@localhost:3306/ark
# Docker and local development use PostgreSQL:
DATABASE_URL=postgres://ark:ark@localhost:5432/ark
# Seconds a database connection is kept open for reuse (0 closes it after each
# request), and whether a reused one is checked first. Keep the check on when
# the server is across a network, where idle connections get dropped.
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=true
# MySQL only: seconds before a connect, read or write is given up, so a server
# that stops answering cannot hold every request thread for minutes.
# DB_CONNECT_TIMEOUT=5
# DB_READ_TIMEOUT=60
# DB_WRITE_TIMEOUT=60

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ark.digital.utsc.utoronto.ca
DJANGO_TIME_ZONE=America/Toronto
DJANGO_LOG_LEVEL=INFO

# Enable once the TLS certificate is known good — it is hard to walk back.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Read only when DJANGO_DEBUG is false. Set both false on a plain-HTTP demo
# stack (the Docker dev stack does); keep them true behind TLS.
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Broker and cache: Valkey or Redis. Valkey speaks the same protocol, so the
# URLs keep the redis:// scheme (rediss:// for TLS) whichever one runs.
# Production should require a password: redis://:password@host:6379/0, or
# redis://user:password@host:6379/0 for a named account. Percent-encode
# anything but letters and digits.
CELERY_BROKER_URL=redis://localhost:6379/0
# Where task results would go; nothing reads them, so it defaults to the broker.
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Seconds a task (one bulk bind) may run before it is killed. The broker's
# visibility timeout is this plus 600, so an unfinished job is not handed out twice.
# CELERY_TASK_TIME_LIMIT=3600
# Beat's state file. /tmp because the systemd unit and the container make the
# working directory read-only; losing it only delays the first run by one interval.
# CELERY_BEAT_SCHEDULE_FILENAME=/tmp/celerybeat-schedule

# Required in production (the service refuses to start without it). Holds the
# login lockout, the staff-side cache and the buffered redirect counters. The
# resolver keeps working if this server is down: hits are then written
# straight to the database.
REDIS_URL=redis://localhost:6379/1
# Seconds to wait on that server before giving up.
CACHE_SOCKET_TIMEOUT=0.5

# Sign-in throttling.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Set true only when a reverse proxy sets X-Forwarded-For and nothing else can
# reach gunicorn directly; otherwise the header is attacker-controlled.
TRUST_FORWARDED_FOR=false
SESSION_COOKIE_AGE=28800

# How often buffered redirect counts are written to the database.
RESOLUTION_FLUSH_SECONDS=60
# How often the scheduler recounts collection statistics and element names;
# large collections show these stored figures ("as of HH:MM").
# COLLECTION_STATS_SECONDS=300
# Run bulk-bind jobs inline instead of on a worker (handy on a bare dev box):
# CELERY_TASK_ALWAYS_EAGER=true

# Base URL the admin UI shows for an ARK's resolvable address. Empty derives it
# from the request, which is right when staff use the same hostname the
# resolver answers on. Set it only when the two differ.
# ARK_PUBLIC_BASE_URL=https://ark.digital.utsc.utoronto.ca

# /manifest fetches someone else's server while holding a worker; keep it short.
# The first bounds each read, the second the whole fetch.
MANIFEST_FETCH_TIMEOUT=30
MANIFEST_TOTAL_TIMEOUT=30
# Concurrent /manifest fetches per gunicorn process.
MANIFEST_MAX_CONCURRENT=4
# Largest manifest body the proxy will pass on, in bytes (10 MiB).
# MANIFEST_MAX_BYTES=10485760
BULK_BIND_MAX_ROWS=100000
BULK_BIND_MAX_BYTES=52428800
# Django's own request-body ceilings: the non-file part of a POST (20 MiB) and
# the size above which an uploaded file is spooled to disk instead of memory
# (5 MiB). Neither bounds a bulk-bind upload; BULK_BIND_MAX_BYTES does.
# DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
# FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
# Staff-side limits for large collections. Sorting the ARK list by redirects or
# elements is only offered on result sets up to this many rows, and a UI export
# larger than EXPORT_SYNC_MAX_ROWS points to the export_arks command instead.
# SORT_SUBQUERY_MAX_ROWS=50000
# EXPORT_SYNC_MAX_ROWS=100000
# Optional plugins: separately installed Django apps, comma-separated. The
# staff command line (createcollection, mint, bind, unbind, bulk_bind,
# ark_stats) is the arks-cli package (github.com/digitalutsc/arks-cli, not on
# PyPI): install it from a checkout (uv pip install -e ../arks-cli), then
# ARKS_PLUGINS=arks_cli.
# Naming a plugin that is not installed stops the service with a clear error.
ARKS_PLUGINS=
# Largest single mint from the form or the mint command; 0 removes the cap.
# Bulk bind is bounded by BULK_BIND_MAX_ROWS instead.
MINT_MAX_PER_REQUEST=10000
# A directory of operator-written index.html, 403.html, 404.html, 500.html and
# their assets, served in place of the built-in landing page and Django's plain
# error pages. Empty means off. Starting kit: docs/fallback-example/.
# FALLBACK_PAGES_DIR=/srv/ark/fallback
# Days to keep finished bulk-bind jobs and their files; 0 keeps them forever.
BULK_BIND_RETENTION_DAYS=0
# Where bulk-bind results files (and uploads, until their job ends) are kept.
# Defaults to media/ inside the checkout, the path the systemd units make writable.
# MEDIA_ROOT=./media
