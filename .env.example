# Copy to .env and edit. Nothing here refers to the project directory name, so
# the checkout can be renamed freely.
#
# DJANGO_SECRET_KEY and DATABASE_URL are REQUIRED whenever DJANGO_DEBUG is
# false; the service refuses to start without them rather than silently serving
# 404s from an empty SQLite file with a well-known key.

# Set to true for local development. Leave false everywhere else.
DJANGO_DEBUG=false

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Production uses an existing MySQL/MariaDB server, on the same machine or
# across the network. Percent-encode special characters in the password.
# DATABASE_URL=mysql://arkuser:password@localhost:3306/ark
# Docker and local development use PostgreSQL:
DATABASE_URL=postgres://ark:ark@localhost:5432/ark
# Seconds a database connection is kept open for reuse (0 closes it after each
# request), and whether a reused one is checked first. Keep the check on when
# the server is across a network, where idle connections get dropped.
# DB_CONN_MAX_AGE=60
# DB_CONN_HEALTH_CHECKS=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ark.digital.utsc.utoronto.ca
DJANGO_TIME_ZONE=America/Toronto
DJANGO_LOG_LEVEL=INFO

# Enable once the TLS certificate is known good — it is hard to walk back.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# Broker and cache: Valkey or Redis. Valkey speaks the same protocol, so the
# URLs keep the redis:// scheme (rediss:// for TLS) whichever one runs.
# Production should require a password: redis://:password@host:6379/0, or
# redis://user:password@host:6379/0 for a named account. Percent-encode
# anything but letters and digits.
CELERY_BROKER_URL=redis://localhost:6379/0

# Required in production (the service refuses to start without it). Holds the
# login lockout, the staff-side cache and the buffered redirect counters. The
# resolver keeps working if this server is down: hits are then written
# straight to the database.
REDIS_URL=redis://localhost:6379/1
# Seconds to wait on that server before giving up.
CACHE_SOCKET_TIMEOUT=0.5

# Sign-in throttling.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Set true only when a reverse proxy sets X-Forwarded-For and nothing else can
# reach gunicorn directly; otherwise the header is attacker-controlled.
TRUST_FORWARDED_FOR=true
SESSION_COOKIE_AGE=28800

# How often buffered redirect counts are written to the database.
RESOLUTION_FLUSH_SECONDS=60
# Run bulk-bind jobs inline instead of on a worker (handy on a bare dev box):
# CELERY_TASK_ALWAYS_EAGER=true

# Base URL the admin UI shows for an ARK's resolvable address. Empty derives it
# from the request, which is right when staff use the same hostname the
# resolver answers on. Set it only when the two differ.
# ARK_PUBLIC_BASE_URL=https://ark.digital.utsc.utoronto.ca

# /manifest fetches someone else's server while holding a worker; keep it short.
MANIFEST_FETCH_TIMEOUT=5
BULK_BIND_MAX_ROWS=100000
BULK_BIND_MAX_BYTES=52428800
# Largest single mint; 0 removes the cap. The mint form runs inside the web
# request, so a batch that outlasts the gunicorn timeout fails and rolls back.
MINT_MAX_PER_REQUEST=10000
