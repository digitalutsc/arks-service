# Copy to .env and adjust. Nothing here refers to the project directory name,
# so the checkout can be renamed freely.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ark.digital.utsc.utoronto.ca
DJANGO_TIME_ZONE=America/Toronto
DJANGO_LOG_LEVEL=INFO

# Production (LAMP VM) uses the existing MySQL/MariaDB server:
# DATABASE_URL=mysql://arkuser:password@localhost:3306/ark
# Docker/dev uses PostgreSQL:
# DATABASE_URL=postgres://ark:ark@localhost:5432/ark
# Omit entirely to fall back to a local SQLite file (tests only).
DATABASE_URL=postgres://ark:ark@localhost:5432/ark

CELERY_BROKER_URL=redis://localhost:6379/0
# Run bulk-bind jobs inline instead of on a worker (handy for a bare dev box):
# CELERY_TASK_ALWAYS_EAGER=true

MANIFEST_FETCH_TIMEOUT=30
BULK_BIND_MAX_ROWS=100000
