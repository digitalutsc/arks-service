# /etc/systemd/system/arkservice-worker.service
[Unit]
Description=ARK identifier service (celery worker for bulk binds)
After=network.target redis-server.service mysql.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/arkservice
EnvironmentFile=/var/www/arkservice/.env
# --beat runs the periodic redirect-counter flush alongside the worker. With
# more than one worker host, run beat on exactly one of them instead.
ExecStart=/var/www/arkservice/.venv/bin/celery -A arkservice worker --beat \
    --loglevel=info --concurrency=2 --logfile=/var/log/arkservice/worker.log
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Hardening. The service needs to write only its logs and MEDIA_ROOT.
ProtectSystem=strict
ReadWritePaths=/var/log/arkservice /var/www/arkservice/media
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=2G


[Install]
WantedBy=multi-user.target
