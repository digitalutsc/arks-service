# /etc/systemd/system/arkservice-worker.service
[Unit]
Description=ARK identifier service (celery worker for bulk binds)
# Scheduled housekeeping (the redirect-count flush, the stale-job reaper,
# session cleanup) runs in arkservice-beat.service, on its own queue, so a long
# bulk bind here can never delay it.
# The broker is Redis or Valkey, whichever is installed: Debian and Ubuntu
# name their units redis-server and valkey-server. systemd ignores a wanted
# unit that does not exist, so both are listed and this file needs no edit.
# The same goes for mysql.service when MySQL is on another machine, which is
# also why this waits for network-online rather than network.
After=network-online.target redis-server.service valkey-server.service mysql.service
Wants=network-online.target redis-server.service valkey-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/arkservice
EnvironmentFile=/var/www/arkservice/.env
# -Q celery: bulk binds only. --max-tasks-per-child and --max-memory-per-child
# (KiB) replace a worker process after 20 jobs or once it has grown past ~1 GB,
# so the memory a 100k-row file needed is given back.
ExecStart=/var/www/arkservice/.venv/bin/celery -A arkservice worker -Q celery \
    --loglevel=info --concurrency=2 --max-tasks-per-child 20 \
    --max-memory-per-child 1000000 --logfile=/var/log/arkservice/worker.log
Restart=on-failure
RestartSec=5s
# Celery's warm shutdown waits for running jobs. Give a bulk bind two minutes
# to finish before systemd kills it; a job killed anyway is marked failed
# ("nothing was applied") on redelivery or by the stale-job reaper.
TimeoutStopSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Hardening. The service needs to write only its logs and MEDIA_ROOT.
ProtectSystem=strict
ReadWritePaths=/var/log/arkservice /var/www/arkservice/media
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=2G


[Install]
WantedBy=multi-user.target
