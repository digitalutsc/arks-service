# /etc/systemd/system/arkservice.service
[Unit]
Description=ARK identifier service (gunicorn)
# network-online, not just network: when MySQL is on another machine the
# first request needs a route to it, not merely configured interfaces. The
# mysql.service ordering only matters when the server is on this VM; on a VM
# without one, systemd ignores it.
# The cache server (valkey-server or redis-server, whichever is installed) is
# ordered first too, so the first requests do not find it missing. Neither is
# required: the resolver keeps working without it.
After=network-online.target mysql.service valkey-server.service redis-server.service
Wants=network-online.target mysql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/arkservice
EnvironmentFile=/var/www/arkservice/.env
ExecStart=/var/www/arkservice/.venv/bin/gunicorn \
    arkservice.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --threads 8 \
    --worker-class gthread \
    --timeout 60 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 2000 \
    --max-requests-jitter 200 \
    --error-logfile /var/log/arkservice/error.log
# No --access-logfile: Apache already logs every request
# (/var/log/apache2/arkservice-access.log), and a second line per redirect only
# doubled the disk use. --max-requests recycles each worker process after about
# 2000 requests, so slow memory growth is returned to the system.
# --keep-alive 5 must stay above Apache's ttl=3 on ProxyPass (see
# apache-arkservice.conf), or Apache reuses a connection gunicorn has closed.
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Hardening. The service needs to write only its logs and MEDIA_ROOT.
ProtectSystem=strict
ReadWritePaths=/var/log/arkservice /var/www/arkservice/media
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=2G


[Install]
WantedBy=multi-user.target
