# /etc/systemd/system/arkservice-beat.service
[Unit]
Description=ARK identifier service (celery beat and scheduled housekeeping)
# Runs the schedule (Celery beat) and the small worker that executes it: the
# redirect-count flush every RESOLUTION_FLUSH_SECONDS, the collection-stats
# refresh every COLLECTION_STATS_SECONDS, the stale-job reaper, daily session
# cleanup and optional bulk-bind retention. Its queue is
# "periodic", separate from the bulk binds in arkservice-worker.service.
# Run exactly one of these, even with several worker hosts.
After=network-online.target redis-server.service valkey-server.service mysql.service
Wants=network-online.target redis-server.service valkey-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/arkservice
EnvironmentFile=/var/www/arkservice/.env
# Beat's state file goes to /tmp (CELERY_BEAT_SCHEDULE_FILENAME's default),
# which PrivateTmp makes private and writable. The working directory is
# read-only under ProtectSystem=strict; writing the file there is what stopped
# the counter flush from ever running.
ExecStart=/var/www/arkservice/.venv/bin/celery -A arkservice worker -Q periodic \
    --pool solo --concurrency 1 --beat \
    --loglevel=info --logfile=/var/log/arkservice/beat.log
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/arkservice /var/www/arkservice/media
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=512M


[Install]
WantedBy=multi-user.target
